<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF161B25">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cues" android:textColor="#FF8DACFF" android:textStyle="bold" />
    <TextView android:id="@+id/now_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF5F7FF" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/next_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFB7C0D3" android:layout_marginTop="4dp" />
</LinearLayout>
