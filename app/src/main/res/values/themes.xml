<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kept intentionally quiet: Compose owns the screen design after launch. -->
    <style name="Theme.Cues" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">?android:attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?android:attr/isLightTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- A proper system splash, not a branding Activity. The compat library
         makes this same intentional handoff available below Android 12.
         Kinetic Obsidian: the same void the launcher icon's background
         layer uses, so home-screen icon -> splash -> app reads as one
         continuous surface rather than a light-to-dark flash. -->
    <style name="Theme.Cues.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0C0E14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cues_splash</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.Cues</item>
    </style>
</resources>
