<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Every permission here is required by a specific entry in the action
      registry or a specific event adapter. There is no microphone-in-the-
      background permission, no notification-listener access and no location:
      context in Cues is declared, and a permission we do not need is a promise
      we would have to keep explaining.
    -->

    <!-- Resolving the chosen paired device and observing its connection. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Speech recognition, only ever after a user gesture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Showing the running session and its outcome. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Any-Wi-Fi observation does not require the SSID/location permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The app-owned quiet rule (AutomaticZenRule). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      A countdown that ends "some time in the next fifteen minutes" is not a
      countdown. If this is refused, the app says the timing is approximate
      rather than claiming precision it does not have.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Reconciling sessions that were running when the phone restarted. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      R4 (CLEANUP.md CL-06): com.google.android.datatransport:transport-backend-cct,
      a telemetry dependency pulled in transitively through MediaPipe's GenAI
      library, merges this in. Cues has no network path — see CLAUDE.md and
      "Not in these sprints" in docs/SPRINT_4_5.md — so it is removed rather
      than carried as an unused, unexplainable permission on the review screen.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".CuesApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cues">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Cues.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The session's own foreground service. Cues owns its timer rather than
          asking a clock app to run one, so cancellation and receipts stay under
          its control.
        -->
        <service
            android:name=".runtime.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Running a user-approved focus session with a visible countdown." />
        </service>

        <service
            android:name=".runtime.CueTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="Cues">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <receiver android:name=".widget.NowNextWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/now_next_widget_info" />
        </receiver>

        <!--
          Registered in the manifest so a connection can start the app.
          exported="true" is required, not optional: these broadcasts
          (Bluetooth ACL, power, boot) are sent by the system, a different
          UID from Cues, and an unexported receiver only accepts intents
          from within the app's own UID — it would never fire at all,
          on any phone, regardless of Doze or background-execution
          limits. Confirmed on an emulator: exported="false" here meant
          zero charging/Bluetooth events ever reached the app. All three
          actions are protected system broadcasts, so exported="true"
          does not let another app spoof them. Whether delivery survives
          Doze and OEM battery policy on the target phone remains a real
          device question — that part is still on the event spike list.
        -->
        <receiver
            android:name=".runtime.BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".runtime.PowerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".runtime.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".runtime.DeadlineReceiver" android:exported="false" />
        <receiver android:name=".runtime.TimeTriggerReceiver" android:exported="false" />

        <!-- Fires when a pending disconnect's reconnect-grace window elapses. -->
        <receiver android:name=".runtime.GraceReceiver" android:exported="false" />

        <!-- The session notification's own stop action (4.4). -->
        <receiver android:name=".runtime.StopSessionReceiver" android:exported="false" />

    </application>
</manifest>
