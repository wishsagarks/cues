<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Every permission here is required by a specific entry in the action
      registry or a specific event adapter. There is no microphone-in-the-
      background permission, no notification-listener access and no location:
      context in Cues is declared, and a permission we do not need is a promise
      we would have to keep explaining.
    -->

    <!-- Resolving the chosen paired device and observing its connection. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Speech recognition, only ever after a user gesture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Showing the running session and its outcome. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Any-Wi-Fi observation does not require the SSID/location permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The app-owned quiet rule (AutomaticZenRule). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      A countdown that ends "some time in the next fifteen minutes" is not a
      countdown. If this is refused, the app says the timing is approximate
      rather than claiming precision it does not have.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      SET_ALARM's handoff: the platform's common-intents guide requires the
      caller to hold this to invoke AlarmClock.ACTION_SET_ALARM at all. A
      normal, install-time permission; no prompt, and the clock app still
      shows its own confirm screen because Cues never passes EXTRA_SKIP_UI.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Reconciling sessions that were running when the phone restarted. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      CL-35: the one, opt-in exception to "no network." Used only by the
      cloud language assist feature (Sarvam AI) — off by default, gated on a
      user-visible toggle and a configured API key, and never on any path
      downstream of approval. See docs/PERMISSIONS.md and docs/FDD.md's
      "Optional cloud assist" section. Previously removed via
      tools:node="remove" (R4/CL-06) because nothing used it; now it is used,
      deliberately, so it is declared rather than left as a dependency-merged
      accident.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      "Point at your timetable" (Task 12). One-shot, user-invoked capture
      only — no background camera use, and gallery import via the system
      Photo Picker needs no storage/media permission of its own.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Condition.CalendarBusy/CalendarNotBusy only ever reads whether some
      event covers a moment — see CalendarReadings.kt. Cues never reads an
      event's title, attendees or any other detail, and a cue using neither
      condition never requests this at all (see ActionRegistry-derived
      requiredCapabilities).
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Package visibility (API 30+): without this, queryIntentActivities sees
      only Cues itself. This <queries> declaration is the sanctioned,
      Play-reviewable way to see every launcher-visible app — the same set
      the home screen and app drawer already show — for the OPEN_APP picker.
      It grants no broader visibility than that filter, and nothing here can
      see an app's data, only that it exists and how it launches.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- COMPOSE_MESSAGE's ACTION_SENDTO / smsto: handoff. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- ADD_CALENDAR_EVENT's ACTION_INSERT into the calendar provider. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- SET_ALARM's AlarmClock.ACTION_SET_ALARM. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- OPEN_LINK's two allowed schemes — see ActionRegistry.ALLOWED_LINK_SCHEMES. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".CuesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cues">

        <!--
          LiteRT-LM's GPU backend (a fallback tier below NPU) needs these
          declared explicitly, per docs/API_VERIFICATION.md. required="false"
          because the CPU tier must keep working on a device without them.
        -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Cues.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share target (Task 9 / FDD "Shared timetable", generalized to
              any shared text): the received text lands in the draft box as
              plain, editable data — MainActivity.sharedOrCapturedText and
              HomeScreen's incomingText — never executed, never auto-armed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The session's own foreground service. Cues owns its timer rather than
          asking a clock app to run one, so cancellation and receipts stay under
          its control.
        -->
        <service
            android:name=".runtime.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Running a user-approved focus session with a visible countdown." />
        </service>

        <service
            android:name=".runtime.CueTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="Cues">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <receiver android:name=".widget.NowNextWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/now_next_widget_info" />
        </receiver>

        <!--
          Registered in the manifest so a connection can start the app.
          exported="true" is required, not optional: these broadcasts
          (Bluetooth ACL, power, boot) are sent by the system, a different
          UID from Cues, and an unexported receiver only accepts intents
          from within the app's own UID — it would never fire at all,
          on any phone, regardless of Doze or background-execution
          limits. Confirmed on an emulator: exported="false" here meant
          zero charging/Bluetooth events ever reached the app. All three
          actions are protected system broadcasts, so exported="true"
          does not let another app spoof them. Whether delivery survives
          Doze and OEM battery policy on the target phone remains a real
          device question — that part is still on the event spike list.
        -->
        <receiver
            android:name=".runtime.BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".runtime.PowerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".runtime.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".runtime.DeadlineReceiver" android:exported="false" />
        <receiver android:name=".runtime.TimeTriggerReceiver" android:exported="false" />

        <!-- Fires when a pending disconnect's reconnect-grace window elapses. -->
        <receiver android:name=".runtime.GraceReceiver" android:exported="false" />

        <!-- The session notification's own stop action (4.4). -->
        <receiver android:name=".runtime.StopSessionReceiver" android:exported="false" />

        <!--
          The Desk Bridge's only reason for a provider: sharing the generated
          Cue Console HTML file via the share sheet (Office Kit or otherwise)
          needs a content:// Uri — Android forbids sharing a raw file:// path
          outside this app. grantUriPermissions is scoped to the paths in
          file_paths.xml, currently just the one cache subdirectory this
          writes the console to.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          CL-38: the developer-facing local Gemma surface — a call-only
          provider (see app/.../devkit/CuesGemmaProvider.kt), not a data
          provider; every cursor/mutation method it inherits refuses. No
          <uses-permission> gates it because ContentProvider.call() needs
          none; the only protection is CuesApplication.externalGemmaGate's
          in-memory, off-by-default toggle plus its own caller-package log —
          disclosed as a real limitation, not hidden, in CLEANUP.md CL-38.
        -->
        <provider
            android:name=".devkit.CuesGemmaProvider"
            android:authorities="${applicationId}.gemma"
            android:exported="true" />

        <!--
          "Cues: iQOO utility bindings" (Task 16). Off by default; the user
          enables it from system Accessibility settings after reading its
          own consent text (@string/utility_bindings_accessibility_description).
          exported="true" with the BIND_ACCESSIBILITY_SERVICE permission is
          the platform-mandated shape for every accessibility service — the
          permission is what actually restricts binding to the system,
          the same reasoning the broadcast receivers above already document.
        -->
        <service
            android:name=".runtime.CuesAccessibilityService"
            android:exported="true"
            android:label="Cues: iQOO utility bindings"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/utility_bindings_accessibility" />
        </service>

        <!-- "Cue this screen" (Task 16): a Quick Settings entry point for the one-shot read. -->
        <service
            android:name=".runtime.ScreenTile"
            android:exported="true"
            android:icon="@drawable/cues_logo"
            android:label="Cue this screen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <!--
          AppFunctions (Task 17): the class name here is the KSP-generated
          concrete service (BaseCuesAppFunctionService's serviceName,
          "CuesAppFunctionService", in the same package), never hand-written.
          Neither it nor the app_metadata/schema resources below have ever
          actually been generated in the environment that wrote this — no
          Android SDK, so KSP has never run. Structure copied from the
          official guide; see docs/API_VERIFICATION.md and CLEANUP.md CL-24.
        -->
        <service
            android:name=".appfunctions.CuesAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="cues_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

    </application>
</manifest>
